# 1. Môi trường ảo Python (Rất nặng và cấu hình riêng theo mỗi máy)
.venv/
venv/
env/

# 2. Dữ liệu gốc CIFAR-10 (Có thể tự tải lại bằng code, không nên push lên Git)
/Data/*

# 3. Kết quả trích xuất đặc trưng (Chứa file .npy và base64 rất nặng)
/features/*

# 4. Trọng số mô hình huấn luyện (Rất nặng)
model/



# 6. Các file rác của Hệ điều hành (MacOS/Windows)
.DS_Store
Thumbs.db

# 7. Cache Python / build (Lưu ý: uv.lock thì NÊN commit, không bỏ qua)
__pycache__/
*.py[cod]
.ruff_cache/
build/
dist/
*.egg-info/