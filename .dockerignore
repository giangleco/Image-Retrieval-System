# Môi trường ảo & cache (sẽ được tạo lại trong image)
.venv/
__pycache__/
*.py[cod]
.ruff_cache/

# Git
.git/
.gitignore

# Dữ liệu nặng — KHÔNG nhúng vào image, sẽ mount qua volume lúc chạy
data/
features/

# Tài liệu & báo cáo — không cần cho runtime
docs/
*.docx
*.pdf
*.md
!README.md

# Rác hệ điều hành
.DS_Store
Thumbs.db
