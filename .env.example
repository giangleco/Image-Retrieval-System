# ============================================================================
#  Cấu hình chatbot (đa nhà cung cấp). KHÔNG bắt buộc — thiếu hết thì chạy
#  rule-based (offline). Copy file này thành .env rồi điền giá trị.
# ============================================================================

# Chọn provider: auto (thử Azure -> Gemini -> rule-based) | azure | gemini | none
# Chấp nhận bí danh: google/googleai/genai = gemini, azure-openai/openai = azure, off = none.
# Giá trị KHÔNG thuộc danh sách trên sẽ tắt chatbot LLM và in cảnh báo lúc khởi động.
CHAT_PROVIDER=auto

# --- Provider 1: Azure OpenAI (ưu tiên khi auto) ---
# Lấy trong Azure Portal > tài nguyên Azure OpenAI > Keys and Endpoint
AZURE_OPENAI_API_KEY=your_azure_key_here
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your_deployment_name   # TÊN DEPLOYMENT (không phải tên model gốc)
# AZURE_OPENAI_API_VERSION=2024-10-21

# --- Provider 2: Gemini (Google AI Studio) ---
# Lấy key miễn phí tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-2.5-flash          # gemini-2.0-flash đã bị khai tử, dùng 2.5-flash
